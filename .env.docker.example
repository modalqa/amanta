POSTGRES_PASSWORD=
POSTGRES_DB=amanta
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
S3_BUCKET=amanta-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
