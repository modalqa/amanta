# ─── Copy to .env and fill in. Never commit .env. ───

# Public base URL of the app (used for links in notifications and Origin checks)
APP_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://amanta:amanta_dev@localhost:5432/amanta

# 32-byte key, base64-encoded, used for AES-256-GCM encryption of stored secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Set to "true" only when served over HTTPS (adds the Secure flag to cookies)
COOKIE_SECURE=false

# ─── Object storage ───
# "s3" (MinIO, AWS S3, Cloudflare R2, Wasabi, ...) or "local" (development/tests only)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=amanta-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional server-side encryption header value, e.g. AES256 (leave empty for MinIO without KMS)
S3_SSE=

# Max upload size in megabytes
UPLOAD_MAX_MB=20

# ─── AI provider ───
# "anthropic", "openai" (any OpenAI-compatible Chat Completions API) or "none"
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Hard limits for AI calls
AI_TIMEOUT_MS=90000
AI_MAX_INPUT_CHARS=60000

# ─── Jobs ───
# Run the worker with `npm run worker`. Daily alert scan (cron, server timezone UTC)
ALERTS_CRON="0 23 * * *"
